@include numbers
@include strings
keywords \b(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\b
types \b(True|False|None|int|float|str|bool|list|dict|set|tuple|bytes|bytearray|memoryview|range|frozenset|complex|type|object)\b
functions \b(print|len|range|type|str|int|float|list|dict|set|tuple|open|input|format|sorted|reversed|enumerate|zip|map|filter|reduce|sum|min|max|abs|round|pow|all|any|isinstance|issubclass|hasattr|getattr|setattr|delattr|callable|repr|id|hash|dir|vars|globals|locals|eval|exec|compile)\b
decorators @[a-zA-Z_][a-zA-Z0-9_]*
comments #[^\n]*
comments? '''|'''
comments? """|"""
