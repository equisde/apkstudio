@include numbers
@include strings
keywords \b(if|then|else|elif|fi|case|esac|for|while|until|do|done|in|function|select|time|coproc)\b
builtins \b(echo|printf|read|cd|pwd|pushd|popd|dirs|let|eval|set|unset|export|declare|typeset|readonly|local|source|alias|unalias|bind|builtin|caller|command|enable|help|logout|mapfile|readarray|test|type|ulimit|umask|wait|exec|exit|return|trap|break|continue|shift)\b
variables \$[a-zA-Z_][a-zA-Z0-9_]*|\$\{[^}]+\}|\$[0-9@#?$!*-]
comments #[^\n]*
